NODE_ENV=development
HOST=0.0.0.0
PORT=3100
SCHOOL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revolt_x_school
CORE_OS_URL=https://revolt-x-os.onrender.com
# Must match Core OS SCHOOL_SERVICE_KEY. Keep this server-side only.
CORE_SERVICE_KEY=
CORS_ORIGINS=http://localhost:3100
DB_POOL_MAX=5
PROVISION_DEMO_TEACHERS=false
ENABLE_TEST_PORTAL_ACCESS=false
TEST_ACCESS_PASSWORD=

# Public application URL used for payment callbacks.
PUBLIC_BASE_URL=http://localhost:3100

# Email provider (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMS and WhatsApp provider (Twilio)
# Production: prefer API Key SID + API Key Secret. Auth Token is a fallback for testing.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Optional but required for reliable business-initiated WhatsApp alerts outside the 24-hour session.
# Template variables expected: {{1}} recipient name, {{2}} subject, {{3}} notification details.
TWILIO_WHATSAPP_CONTENT_SID=

# Online Mobile Money and card provider (Paystack)
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS
