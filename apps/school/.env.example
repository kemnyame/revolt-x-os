NODE_ENV=development
HOST=0.0.0.0
PORT=3100
SCHOOL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revolt_x_school
CORE_OS_URL=https://revolt-x-os.onrender.com
# Must match Core OS SCHOOL_SERVICE_KEY. Keep this server-side only.
CORE_SERVICE_KEY=
# Optional public incident notice. Stop sign-in startup retries during a confirmed
# Core outage. Healthy Core readiness overrides it; clear it after recovery.
CORE_SIGN_IN_OUTAGE_MESSAGE=
CORS_ORIGINS=http://localhost:3100
DB_POOL_MAX=5
PROVISION_DEMO_TEACHERS=false
ENABLE_TEST_PORTAL_ACCESS=false
TEST_ACCESS_PASSWORD=
# Initial/reset password issued to School staff. Login uses Staff ID + password.
STAFF_GENERIC_PASSWORD=RevoltX@2026

# Public application URL used for payment callbacks.
PUBLIC_BASE_URL=http://localhost:3100

# Email provider
# auto = use Brevo when configured, otherwise fall back to Resend.
EMAIL_PROVIDER=auto
# auto detects Resend's test sender. production rejects test senders.
EMAIL_DELIVERY_MODE=auto
EMAIL_REPLY_TO=

# Brevo transactional email
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Revolt-X School

# Optional legacy fallback
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Test delivery is allowed only to this address; parent messages are never redirected.
RESEND_TEST_RECIPIENT=emmanuelnyame25@gmail.com

# WhatsApp: auto selects Meta when its credentials are present, otherwise Twilio.
WHATSAPP_PROVIDER=auto
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Enables read-only checks of template approval.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_GB
# Approved template body variables: {{1}} recipient, {{2}} subject, {{3}} message.
# Free-form messages require an active 24-hour customer-service window.
# Keep false for automatic commercial notifications.
WHATSAPP_ALLOW_SESSION_MESSAGES=false

# SMS and WhatsApp provider (Twilio)
# Production: prefer API Key SID + API Key Secret. Auth Token is a fallback for testing.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Required for business-initiated WhatsApp alerts outside the 24-hour session.
# Template variables expected: {{1}} recipient name, {{2}} subject, {{3}} notification details.
TWILIO_WHATSAPP_CONTENT_SID=

# Online Mobile Money and card provider (Paystack)
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS
