{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/", "destination": "/api?__path=/" },
    { "source": "/:path*", "destination": "/api?__path=/:path*" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  }
}
